# =============================================================================
# Robinity Intelligence — VPS & Production Environment Configuration
# =============================================================================

# Node Environment
NODE_ENV=production
TEST_PANEL_PORT=4173
TRUST_PROXY=1

# Master encryption key for admin authentication and sensitive state (min 32 chars recommended)
# Leave empty to auto-generate admin-auth.key on first run, or set a 32+ char secret.
ADMIN_AUTH_MASTER_KEY=

# ─── Upstream Risk & Metadata Providers ─────────────────────────────────────
# Server-side only. Use free/trial accounts with billing/overages disabled.
HELIUS_API_KEY=
ETHERSCAN_API_KEY=

# Bitquery (trial token and expiry timestamp)
BITQUERY_ACCESS_TOKEN=
BITQUERY_FREE_TRIAL_UNTIL=2026-10-17T00:00:00+03:00

# GoPlus — access token VEYA app_key + app_secret kullanılabilir
GOPLUS_ACCESS_TOKEN=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# ─── PostgreSQL Database (Durable Queue & Cache Store) ─────────────────────
# Used by docker-compose for the postgres container:
POSTGRES_USER=robinity
POSTGRES_DB=robinity
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Application Database Connection URL:
# - Host'ta Node çalışıyorsa: postgresql://robinity:your_strong_postgres_password_here@127.0.0.1:5432/robinity
# - Docker içi 'app' servisi çalışıyorsa: postgresql://robinity:your_strong_postgres_password_here@postgres:5432/robinity
DATABASE_URL=postgresql://robinity:your_strong_postgres_password_here@127.0.0.1:5432/robinity

# Migration kontrolü (1: başlangıçta otomatik migrate et; üretimde manuel çalıştırmak için boş bırakın)
QUEUE_AUTO_MIGRATE=0

# ─── Redis (BullMQ & Provider Rate Limiter Gate) ───────────────────────────
# - Host'ta Node çalışıyorsa: REDIS_HOST=127.0.0.1
# - Docker içi 'app' servisi çalışıyorsa: REDIS_HOST=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_DB=0
REDIS_TLS=0
